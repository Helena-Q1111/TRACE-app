{
  "name": "trace-visualizer",
  "version": "1.0.0",
  "description": "TRACE Visualizer - 3D Chord Embedding Explorer (desktop app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "edu.nyu.trace.visualizer",
    "productName": "TRACE Visualizer",
    "directories": {
      "output": "../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
